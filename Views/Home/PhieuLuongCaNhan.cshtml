@model IEnumerable<Web_quan_ly_nhan_su.Models.Luong>
@{
    ViewData["Title"] = "Phiếu lương cá nhân - Atelier HR";
}

<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
        theme: {
        extend: {
        colors: {
        "primary": "#0058bc",
        "primary-container": "#0070eb",
        "tertiary": "#006b27",
        "outline": "#717786",
        "error": "#ba1a1a",
        "surface-container": "#eeeef0"
        },
        fontFamily: { "headline": ["Be Vietnam Pro"], "body": ["Inter"] }
        }
        }
        }
    </script>
    <style>
        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        /* Đã sửa: Dùng @@media để trình biên dịch Razor không nhận nhầm thành mã C# */
        @@media print {
        body * {
        visibility: hidden;
        }

        #printArea, #printArea * {
        visibility: visible;
        }

        #printArea {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 20px;
        }
        /* Đã sửa: Dùng @@page để không bị lỗi RZ3906 và RZ1016 */
        @@page {
        margin: 1cm;
        size: A4 portrait;
        }
        }
    </style>
</head>
<body class="bg-[#f9f9fb] font-body text-[#1a1c1d] antialiased">

    <main class="pt-24 pb-32 px-6 max-w-5xl mx-auto space-y-8" id="webArea">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <a href="/Home/TongQuat" class="w-12 h-12 rounded-full bg-white shadow-sm border border-gray-100 flex items-center justify-center hover:bg-gray-50 transition-all active:scale-90">
                    <span class="material-symbols-outlined text-outline">arrow_back</span>
                </a>
                <div>
                    <h1 class="font-headline text-3xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-primary to-primary-container">Lịch sử thu nhập của tôi</h1>
                    <p class="opacity-80 text-sm text-outline mt-1">Bạn có thể xem và tải về/in phiếu lương từng tháng</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-[32px] shadow-[0_20px_40px_rgba(0,0,0,0.03)] border border-zinc-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm whitespace-nowrap">
                    <thead class="bg-gray-50 text-outline font-medium">
                        <tr>
                            <th class="px-6 py-4">Kỳ lương</th>
                            <th class="px-6 py-4">Thu nhập (Cộng)</th>
                            <th class="px-6 py-4">Khấu trừ & BH (Trừ)</th>
                            <th class="px-6 py-4 text-primary font-bold">Thực lãnh</th>
                            <th class="px-6 py-4 text-center">In Phiếu</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                decimal tongThuNhap = item.LuongCoBan + item.TienTangCa + item.Thuong;
                                decimal tongKhauTru = item.KhauTru + item.BaoHiemXaHoi + item.BaoHiemYTe + item.BaoHiemThatNghiep;

                                <tr class="hover:bg-primary/5 transition-colors group">
                                    <td class="px-6 py-4">
                                        <div class="font-bold text-[#1a1c1d]">Tháng @item.Thang</div>
                                        <div class="text-[11px] text-outline mt-0.5">Năm @item.Nam</div>
                                    </td>
                                    <td class="px-6 py-4 font-medium text-tertiary">
                                        @tongThuNhap.ToString("N0") VNĐ
                                    </td>
                                    <td class="px-6 py-4 font-medium text-error">
                                        -@tongKhauTru.ToString("N0") VNĐ
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-3 py-1.5 bg-primary/10 text-primary rounded-xl font-bold text-[13px] ring-1 ring-primary/20">
                                            @item.TongLuong.ToString("N0") VNĐ
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <button onclick="inPhieuLuong('@(item.NhanVien?.HoTen ?? "Chưa rõ")', '@item.Thang', '@item.Nam', '@item.LuongCoBan', '@item.TienTangCa', '@item.Thuong', '@item.KhauTru', '@item.BaoHiemXaHoi', '@item.BaoHiemYTe', '@item.BaoHiemThatNghiep', '@item.TongLuong')"
                                                class="inline-flex items-center gap-1.5 px-4 py-2 bg-gray-50 text-gray-700 hover:bg-primary hover:text-white rounded-xl text-[12px] font-bold transition-all shadow-sm active:scale-95 border border-gray-200">
                                            <span class="material-symbols-outlined text-[18px]">print</span> In
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="py-16 text-center text-outline italic">
                                    <div class="flex flex-col items-center justify-center gap-3">
                                        <span class="material-symbols-outlined text-5xl opacity-40">inventory_2</span>
                                        <p class="font-medium text-[15px]">Bạn chưa có dữ liệu lương nào.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <div id="printArea" class="hidden font-body text-gray-900 bg-white p-8 max-w-3xl mx-auto border border-gray-300">
        <div class="flex justify-between items-end border-b-2 border-gray-800 pb-4 mb-6">
            <div>
                <h1 class="text-2xl font-bold uppercase tracking-wider">CÔNG TY TNHH ATELIER HR</h1>
                <p class="text-sm mt-1">Đường XYZ, Quận 1, TP.HCM | MST: 0123456789</p>
            </div>
            <div class="text-right">
                <h2 class="text-3xl font-headline font-bold text-gray-800">PHIẾU LƯƠNG</h2>
                <p class="text-md italic mt-1" id="pKyLuong">Kỳ lương: Tháng --/----</p>
            </div>
        </div>

        <div class="mb-6 grid grid-cols-2 gap-4">
            <p><span class="font-bold w-32 inline-block">Họ và tên:</span> <span id="pTenNhanVien" class="uppercase text-lg font-bold">---</span></p>
            <p><span class="font-bold w-32 inline-block">Phòng ban:</span> <span>Khối Chuyên Môn</span></p>
        </div>

        <table class="w-full border-collapse border border-gray-400 mb-8">
            <thead>
                <tr class="bg-gray-100">
                    <th class="border border-gray-400 px-4 py-2 text-left w-1/2">Khoản mục</th>
                    <th class="border border-gray-400 px-4 py-2 text-right">Số tiền (VNĐ)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="2" class="border border-gray-400 px-4 py-2 font-bold bg-gray-50 uppercase text-sm">I. THU NHẬP (Cộng)</td>
                </tr>
                <tr>
                    <td class="border border-gray-400 px-4 py-2 pl-8">Lương cơ bản</td>
                    <td class="border border-gray-400 px-4 py-2 text-right" id="pLuongCoBan">0</td>
                </tr>
                <tr>
                    <td class="border border-gray-400 px-4 py-2 pl-8">Phụ cấp tăng ca (Tăng 20%)</td>
                    <td class="border border-gray-400 px-4 py-2 text-right" id="pTangCa">0</td>
                </tr>
                <tr>
                    <td class="border border-gray-400 px-4 py-2 pl-8">Thưởng</td>
                    <td class="border border-gray-400 px-4 py-2 text-right" id="pThuong">0</td>
                </tr>

                <tr>
                    <td colspan="2" class="border border-gray-400 px-4 py-2 font-bold bg-gray-50 uppercase text-sm mt-4">II. KHẤU TRỪ VÀ BẢO HIỂM (Trừ)</td>
                </tr>
                <tr>
                    <td class="border border-gray-400 px-4 py-2 pl-8">BHXH (8%)</td>
                    <td class="border border-gray-400 px-4 py-2 text-right" id="pBHXH">0</td>
                </tr>
                <tr>
                    <td class="border border-gray-400 px-4 py-2 pl-8">BHYT (1.5%)</td>
                    <td class="border border-gray-400 px-4 py-2 text-right" id="pBHYT">0</td>
                </tr>
                <tr>
                    <td class="border border-gray-400 px-4 py-2 pl-8">BHTN (1.0%)</td>
                    <td class="border border-gray-400 px-4 py-2 text-right" id="pBHTN">0</td>
                </tr>
                <tr>
                    <td class="border border-gray-400 px-4 py-2 pl-8">Khấu trừ khác (Phạt/Tạm ứng)</td>
                    <td class="border border-gray-400 px-4 py-2 text-right" id="pKhauTru">0</td>
                </tr>

                <tr class="bg-gray-200">
                    <td class="border border-gray-400 px-4 py-3 font-bold text-lg uppercase text-center">III. TỔNG THỰC LÃNH (I - II)</td>
                    <td class="border border-gray-400 px-4 py-3 text-right font-bold text-xl" id="pTongLuong">0</td>
                </tr>
            </tbody>
        </table>

        <div class="flex justify-between items-start mt-8 pt-8">
            <div class="text-center w-1/3">
                <p class="font-bold">Người lập phiếu</p>
                <p class="text-sm italic mt-1">(Ký, ghi rõ họ tên)</p>
                <br><br><br><br>
                <p class="font-medium">Phòng Hành chính Nhân sự</p>
            </div>
            <div class="text-center w-1/3">
                <p class="italic text-sm mb-1">Ngày ..... tháng ..... năm 20...</p>
                <p class="font-bold">Nhân viên xác nhận</p>
                <p class="text-sm italic mt-1">(Ký, ghi rõ họ tên)</p>
            </div>
        </div>
        <p class="text-center text-xs text-gray-500 italic mt-12 border-t pt-2">Phiếu lương được xuất tự động từ Hệ thống Atelier HR.</p>
    </div>

    <script src="~/js/PhieuLuong.js"></script>
</body>
</html>