@model Web_quan_ly_nhan_su.Models.NhanVien
@{
    ViewData["Title"] = "Hồ sơ nhân sự - " + Model.HoTen;

    // Định dạng hiển thị chuỗi trạng thái hoạt động tài khoản
    string statusText = Model.TrangThai == 1 ? "Đang hoạt động" : "Đã khóa";
    string statusBadgeClass = Model.TrangThai == 1 ? "bg-emerald-50 text-emerald-700 ring-emerald-600/20" : "bg-red-50 text-red-700 ring-red-600/20";
    string statusDotClass = Model.TrangThai == 1 ? "bg-emerald-500" : "bg-gray-400";
}

<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
        theme: {
        extend: {
        colors: {
        "primary": "#0058bc",
        "primary-container": "#0070eb",
        "outline": "#717786",
        "outline-variant": "#c1c6d7",
        "on-surface": "#1a1c1d",
        "on-surface-variant": "#414755",
        "surface-container-lowest": "#ffffff",
        "surface-container-low": "#f3f3f5"
        },
        fontFamily: {
        "headline": ["Be Vietnam Pro"],
        "body": ["Inter"]
        }
        }
        }
        }
    </script>
    <style>
        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        body {
        min-height: 100vh;
        background-color: #f9f9fb;
        }
    </style>
</head>
<body class="font-body text-on-surface antialiased pb-24">

    <main class="pt-12 px-6 max-w-2xl mx-auto space-y-6">

        <div class="flex items-center justify-between">
            <a href="/Home/NhanVien" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-bold text-outline bg-white border border-gray-200 rounded-full hover:text-primary hover:border-primary/30 hover:shadow-md transition-all active:scale-95 w-fit">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                Quay lại danh sách
            </a>

            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider ring-1 @statusBadgeClass">
                <span class="w-1.5 h-1.5 rounded-full @statusDotClass"></span>
                @statusText
            </span>
        </div>

        <section class="bg-white p-6 rounded-[32px] border border-gray-100 shadow-sm flex flex-col items-center text-center space-y-4">
            <div class="relative">
                <img class="w-28 h-28 rounded-[32px] object-cover ring-4 ring-gray-50 shadow-md"
                     src="@(string.IsNullOrEmpty(Model.AnhDaiDien) ? "/images/avatar_default.jpg" : Model.AnhDaiDien)"
                     alt="@Model.HoTen" />
            </div>
            <div>
                <h2 class="font-headline font-bold text-2xl text-gray-900 leading-tight">@Model.HoTen</h2>
                <p class="text-sm text-outline mt-1 font-medium">@(Model.PhongBan?.TenPhongBan ?? "Chưa phân bổ phòng ban")</p>
            </div>
        </section>

        <section class="bg-white rounded-[32px] border border-gray-100 shadow-sm overflow-hidden divide-y divide-gray-100">

            <div class="p-6 bg-gray-50/50">
                <h3 class="font-headline font-bold text-base text-gray-900 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-[20px]">badge</span>
                    Thông tin tài khoản hồ sơ
                </h3>
            </div>

            <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <span class="text-sm font-semibold text-outline">Mã số nhân viên</span>
                <span class="text-sm font-bold text-gray-900 bg-gray-100 px-3 py-1 rounded-xl">#NV@(Model.MaNhanVien)</span>
            </div>

            <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <span class="text-sm font-semibold text-outline">Địa chỉ Email công ty</span>
                <span class="text-sm font-medium text-gray-900 select-all">@Model.Email</span>
            </div>

            <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <span class="text-sm font-semibold text-outline">Số điện thoại liên hệ</span>
                <span class="text-sm font-bold text-gray-900">@(string.IsNullOrEmpty(Model.SoDienThoai) ? "Chưa cập nhật" : Model.SoDienThoai)</span>
            </div>

            <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <span class="text-sm font-semibold text-outline">Giới tính</span>
                <span class="text-sm font-semibold text-gray-900">@(string.IsNullOrEmpty(Model.GioiTinh) ? "Chưa cập nhật" : Model.GioiTinh)</span>
            </div>

            <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <span class="text-sm font-semibold text-outline">Ngày tháng năm sinh</span>
                <span class="text-sm font-bold text-gray-900">@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</span>
            </div>

            <div class="p-6 flex flex-col sm:flex-row sm:items-start justify-between gap-2">
                <span class="text-sm font-semibold text-outline shrink-0">Địa chỉ thường trú</span>
                <span class="text-sm font-medium text-gray-900 sm:text-right max-w-sm leading-relaxed">@(string.IsNullOrEmpty(Model.DiaChi) ? "Chưa cập nhật" : Model.DiaChi)</span>
            </div>

            <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <span class="text-sm font-semibold text-outline">Ngày ký hợp đồng vào làm</span>
                <span class="text-sm font-bold text-primary">@(Model.NgayVaoLam.HasValue ? Model.NgayVaoLam.Value.ToString("dd/MM/yyyy") : "Chưa xác lập")</span>
            </div>

            <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <span class="text-sm font-semibold text-outline">Thời gian tạo hồ sơ</span>
                <span class="text-xs text-outline font-medium">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</span>
            </div>

            <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <span class="text-sm font-semibold text-outline">Dữ liệu trắc sinh học FaceID</span>
                @if (!string.IsNullOrEmpty(Model.FaceVector))
                {
                    <span class="inline-flex items-center gap-1 text-xs font-bold text-emerald-600 bg-emerald-50 px-3 py-1 rounded-xl ring-1 ring-emerald-600/20">
                        <span class="material-symbols-outlined text-[16px]">verified</span> Đã đăng ký
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1 text-xs font-bold text-red-600 bg-red-50 px-3 py-1 rounded-xl ring-1 ring-red-600/20">
                        <span class="material-symbols-outlined text-[16px]">unpublished</span> Chưa đăng ký
                    </span>
                }
            </div>
        </section>
    </main>

</body>
</html>