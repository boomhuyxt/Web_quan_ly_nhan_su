<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Atelier HR - Tổng quan</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#0058bc",
                        "primary-container": "#0070eb",
                        "tertiary": "#006b27",
                        "outline": "#717786",
                        "error": "#ba1a1a",
                        "surface-container": "#eeeef0"
                    },
                    fontFamily: { "headline": ["Be Vietnam Pro"], "body": ["Inter"] }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        body { min-height: 100vh; }
    </style>
</head>
<body class="bg-[#f9f9fb] font-body text-[#1a1c1d] antialiased">

<main class="pt-24 pb-32 px-6 max-w-5xl mx-auto space-y-10">
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 p-8 rounded-[32px] bg-gradient-to-br from-primary to-primary-container text-white flex flex-col justify-between min-h-[200px] shadow-lg relative overflow-hidden">
            <div class="relative z-10">
                <h2 class="font-headline text-3xl font-bold mb-2">Chào buổi sáng!</h2>
                <p class="opacity-80 text-sm leading-relaxed max-w-[280px]">Hệ thống đã sẵn sàng. Chúc bạn một ngày làm việc hiệu quả.</p>
            </div>
            <div class="absolute right-0 bottom-0 w-48 h-48 bg-white/10 rounded-full blur-3xl translate-x-1/2 translate-y-1/2"></div>
        </div>

        <div class="bg-white p-8 rounded-[32px] flex flex-col justify-center items-center text-center shadow-[0_20px_40px_rgba(0,0,0,0.04)] border border-gray-50">
            <div class="w-14 h-14 rounded-2xl bg-tertiary/10 flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-tertiary text-3xl">alarm_on</span>
            </div>
            <div class="text-3xl font-headline font-extrabold text-on-surface"><span id="txtTyLeDungGio">--</span>%</div>
            <div class="text-xs font-medium text-outline uppercase tracking-widest mt-1">Đúng giờ hôm nay</div>
        </div>
    </section>

    <section class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white p-6 rounded-[28px] shadow-sm border border-gray-100 flex flex-col gap-1">
            <span class="text-[11px] font-bold text-outline uppercase">Tổng nhân viên</span>
            <span id="txtTongNhanVien" class="text-2xl font-headline font-bold">--</span>
        </div>
        <div class="bg-white p-6 rounded-[28px] shadow-sm border border-gray-100 flex flex-col gap-1">
            <span class="text-[11px] font-bold text-outline uppercase">Phòng ban</span>
            <span id="txtTongPhongBan" class="text-2xl font-headline font-bold">--</span>
        </div>
        <div class="bg-white p-6 rounded-[28px] shadow-sm border border-gray-100 flex flex-col gap-1 ring-1 ring-error/10 bg-error-container/5">
            <span class="text-[11px] font-bold text-error uppercase">Chưa chấm công</span>
            <span id="txtChuaChamCong" class="text-2xl font-headline font-bold text-error">--</span>
        </div>
        <div class="bg-white p-6 rounded-[28px] shadow-sm border border-gray-100 flex flex-col gap-1 ring-1 ring-emerald-500/10 bg-emerald-50/20">
            <span class="text-[11px] font-bold text-emerald-700 uppercase">Lương gần nhất</span>
            <span id="txtLuongGanNhat" class="text-xl font-headline font-bold text-emerald-700 truncate">--</span>
        </div>
    </section>

    <section class="space-y-6">
        <div class="flex justify-between items-center">
            <h3 class="font-headline font-bold text-xl">Tin nhắn mới (2 giờ qua)</h3>
            <a href="/Home/Chat" class="text-primary font-medium text-sm hover:underline">Mở toàn bộ</a>
        </div>
        <div id="recentActivityList" class="space-y-4">
            <div class="text-center text-sm text-outline animate-pulse py-8">Đang tải dữ liệu...</div>
        </div>
    </section>
</main>

<script>
    document.addEventListener("DOMContentLoaded", async function () {
        try {
            const response = await fetch('/api/tongquan/thong-ke');
            if (response.ok) {
                const data = await response.json();
                if (data.success) {
                    document.getElementById('txtTongNhanVien').innerText = data.tongNhanVien;
                    document.getElementById('txtTongPhongBan').innerText = data.tongPhongBan;
                    document.getElementById('txtChuaChamCong').innerText = data.chuaChamCong;
                    document.getElementById('txtTyLeDungGio').innerText = data.tyLeDungGio;
                    document.getElementById('txtLuongGanNhat').innerText = data.luongGanNhat;

                    const activityList = document.getElementById('recentActivityList');
                    activityList.innerHTML = ''; 

                    if(data.tinNhanMoi && data.tinNhanMoi.length > 0) {
                        data.tinNhanMoi.forEach(msg => {
                            // Tạo đường dẫn sang Chat kèm ID để tự động mở hội thoại
                            const chatUrl = msg.maNhom 
                                ? `/Home/Chat?groupId=${msg.maNhom}` 
                                : `/Home/Chat?userId=${msg.nguoiGuiId}`;

                            const html = `
                            <a href="${chatUrl}" class="group flex items-center gap-4 p-4 rounded-[24px] bg-white hover:bg-blue-50/40 transition-all duration-300 shadow-[0_2px_8px_rgba(0,0,0,0.02)] border border-gray-50">
                                <div class="w-12 h-12 rounded-full overflow-hidden shrink-0 ring-2 ring-transparent group-hover:ring-primary/20 transition-all">
                                    <img class="w-full h-full object-cover" src="${msg.anhDaiDien || '/images/avatar_default.jpg'}"/>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="text-sm font-bold text-on-surface truncate">${msg.nguoiGui}</div>
                                    <div class="text-xs text-outline font-medium leading-snug mt-0.5 truncate">${msg.noiDung}</div>
                                </div>
                                <div class="text-[11px] font-medium text-primary shrink-0">${msg.thoiGian}</div>
                            </a>`;
                            activityList.insertAdjacentHTML('beforeend', html);
                        });
                    } else {
                        activityList.innerHTML = '<div class="text-center text-sm text-outline py-8">Không có tin nhắn mới nào trong 2 giờ qua.</div>';
                    }
                }
            }
        } catch (error) {
            console.error("Lỗi:", error);
        }
    });
</script>
</body>
</html>