<!DOCTYPE html>
<html class="light" lang="vi">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
 <title>Atelier HR - Tổng quan</title>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "outline": "#717786",
              "primary": "#0058bc",
              "surface-tint": "#005bc1",
              "surface-container": "#eeeef0",
              "on-error-container": "#93000a",
              "surface-dim": "#d9dadc",
              "secondary-fixed-dim": "#c7c6cb",
              "primary-container": "#0070eb",
              "secondary-fixed": "#e3e2e7",
              "on-secondary": "#ffffff",
              "on-primary-fixed": "#001a41",
              "on-primary": "#ffffff",
              "surface-container-lowest": "#ffffff",
              "error": "#ba1a1a",
              "on-tertiary": "#ffffff",
              "on-primary-container": "#fefcff",
              "on-surface": "#1a1c1d",
              "on-tertiary-fixed-variant": "#00531c",
              "surface-container-highest": "#e2e2e4",
              "secondary": "#5e5e63",
              "surface-bright": "#f9f9fb",
              "surface-variant": "#e2e2e4",
              "on-secondary-fixed": "#1a1b1f",
              "tertiary-fixed": "#72fe88",
              "error-container": "#ffdad6",
              "outline-variant": "#c1c6d7",
              "inverse-on-surface": "#f0f0f2",
              "surface-container-high": "#e8e8ea",
              "tertiary-container": "#008733",
              "inverse-surface": "#2f3132",
              "on-secondary-container": "#626267",
              "surface-container-low": "#f3f3f5",
              "on-primary-fixed-variant": "#004493",
              "on-error": "#ffffff",
              "on-surface-variant": "#414755",
              "tertiary-fixed-dim": "#53e16f",
              "surface": "#f9f9fb",
              "inverse-primary": "#adc6ff",
              "background": "#f9f9fb",
              "secondary-container": "#e0dfe4",
              "on-secondary-fixed-variant": "#46464b",
              "on-tertiary-fixed": "#002107",
              "primary-fixed": "#d8e2ff",
              "tertiary": "#006b27",
              "on-tertiary-container": "#f7fff2",
              "primary-fixed-dim": "#adc6ff",
              "on-background": "#1a1c1d"
            },
            fontFamily: {
              "headline": ["Be Vietnam Pro"],
              "body": ["Inter"],
              "label": ["Inter"]
            },
            borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
          },
        },
      }
    </script>
<style>
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }
      .tonal-transition { transition: background-color 0.3s ease; }
      .no-scrollbar::-webkit-scrollbar { display: none; }
      .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
      }
      body { min-height: max(884px, 100dvh); }
    </style>
</head>
<body class="bg-surface font-body text-on-surface antialiased">
<header class="fixed top-0 w-full z-50 bg-white/70 backdrop-blur-xl shadow-[0_20px_40px_rgba(0,0,0,0.04)] px-6 py-4 flex justify-between items-center">
<div class="flex items-center gap-4">
<div class="w-10 h-10 rounded-full overflow-hidden bg-surface-container">
<img alt="Ảnh đại diện người dùng" class="w-full h-full object-cover" src="/images/avatar_default.jpg"/>
</div>
<h1 class="font-headline font-bold text-2xl tracking-tight text-zinc-900">Tổng quan</h1>
</div>
<div class="flex items-center gap-3">
<button class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-container-low hover:bg-surface-container transition-colors active:scale-95 duration-200">
<span class="material-symbols-outlined text-on-surface-variant">notifications</span>
</button>
<button class="bg-primary text-white px-4 py-2 rounded-full font-medium flex items-center gap-2 hover:opacity-90 transition-opacity active:scale-95 duration-200">
<span class="material-symbols-outlined text-[20px]">add</span>
</button>
</div>
</header>
<main class="pt-24 pb-32 px-6 max-w-5xl mx-auto space-y-10">
<section class="grid grid-cols-1 md:grid-cols-3 gap-6">
<div class="md:col-span-2 p-8 rounded-[32px] bg-gradient-to-br from-primary to-primary-container text-white flex flex-col justify-between min-h-[220px] shadow-lg relative overflow-hidden">
<div class="relative z-10">
<h2 class="font-headline text-3xl font-bold mb-2">Chào buổi sáng!</h2>
<p class="opacity-80 text-sm leading-relaxed max-w-[280px]">Dưới đây là thông tin thống kê chung của doanh nghiệp ngày hôm nay.</p>
</div>
<div class="relative z-10 mt-6">
<button class="bg-white/20 backdrop-blur-md px-6 py-2 rounded-full text-sm font-medium hover:bg-white/30 transition-colors">Xem lịch trình</button>
</div>
<div class="absolute right-0 bottom-0 w-48 h-48 bg-white/10 rounded-full blur-3xl translate-x-1/2 translate-y-1/2"></div>
</div>

<div class="bg-white p-8 rounded-[32px] flex flex-col justify-center items-center text-center shadow-[0_20px_40px_rgba(0,0,0,0.04)]">
<div class="w-14 h-14 rounded-2xl bg-tertiary/10 flex items-center justify-center mb-4">
<span class="material-symbols-outlined text-tertiary text-3xl">alarm_on</span>
</div>
<div class="text-3xl font-headline font-extrabold text-on-surface"><span id="txtTyLeDungGio">--</span>%</div>
<div class="text-xs font-medium text-outline uppercase tracking-widest mt-1">Đúng giờ hôm nay</div>
</div>
</section>

<section class="grid grid-cols-2 md:grid-cols-4 gap-4">
<div class="bg-white p-6 rounded-[28px] shadow-[0_1px_3px_rgba(0,0,0,0.02)] flex flex-col gap-1">
<span class="text-[11px] font-bold text-outline uppercase tracking-tighter">Tổng nhân viên</span>
<span id="txtTongNhanVien" class="text-2xl font-headline font-bold text-on-surface">--</span>
<div class="mt-2 text-[11px] text-tertiary flex items-center font-medium">
<span class="material-symbols-outlined text-sm mr-1">group</span> Đang hoạt động
</div>
</div>

<div class="bg-white p-6 rounded-[28px] shadow-[0_1px_3px_rgba(0,0,0,0.02)] flex flex-col gap-1">
<span class="text-[11px] font-bold text-outline uppercase tracking-tighter">Phòng ban</span>
<span id="txtTongPhongBan" class="text-2xl font-headline font-bold text-on-surface">--</span>
<div class="mt-2 text-[11px] text-tertiary flex items-center font-medium">
<span class="material-symbols-outlined text-sm mr-1">domain</span> Đang hoạt động
</div>
</div>

<div class="bg-white p-6 rounded-[28px] shadow-[0_1px_3px_rgba(0,0,0,0.02)] flex flex-col gap-1 ring-1 ring-amber-500/10 bg-amber-50/20">
<span class="text-[11px] font-bold text-amber-700 uppercase tracking-tighter">Đơn chờ duyệt</span>
<span id="txtDonChoDuyet" class="text-2xl font-headline font-bold text-amber-700">--</span>
<div class="mt-2 text-[11px] text-amber-600 flex items-center font-medium">
<span class="material-symbols-outlined text-sm mr-1">pending_actions</span> Cần xử lý
</div>
</div>

<div class="bg-white p-6 rounded-[28px] shadow-[0_1px_3px_rgba(0,0,0,0.02)] flex flex-col gap-1 ring-1 ring-error/10 bg-error-container/10">
<span class="text-[11px] font-bold text-error uppercase tracking-tighter">Chưa chấm công</span>
<span id="txtChuaChamCong" class="text-2xl font-headline font-bold text-error">--</span>
<div class="mt-2 text-[11px] text-error flex items-center font-medium">
<span class="material-symbols-outlined text-sm mr-1">person_off</span> Chú ý
</div>
</div>


<section class="space-y-6">
<div class="flex justify-between items-center">
<h3 class="font-headline font-bold text-xl">Hoạt động gần đây</h3>
<button class="text-primary font-medium text-sm hover:underline">Xem tất cả</button>
</div>
<div class="space-y-4">
<div class="group flex items-center gap-4 p-4 rounded-[24px] bg-white hover:bg-surface-container-low transition-colors duration-300 shadow-[0_2px_8px_rgba(0,0,0,0.02)]">
<div class="w-12 h-12 rounded-full overflow-hidden shrink-0">
<img alt="Avatar" class="w-full h-full object-cover" src="/images/avatar_default.jpg"/>
</div>
<div class="flex-1">
<div class="text-sm font-semibold text-on-surface">Trần Minh Quân</div>
<div class="text-xs text-outline leading-snug mt-0.5">Vừa gửi yêu cầu nghỉ phép năm (3 ngày)</div>
</div>
<div class="text-[11px] font-medium text-outline">10 phút trước</div>
</div>
</div>
</section>
</main>

<nav class="fixed bottom-0 w-full z-50 bg-white/80 backdrop-blur-2xl rounded-t-[32px] flex justify-around items-center px-4 py-3 pb-8 shadow-2xl">
<a class="flex flex-col items-center justify-center text-blue-600 bg-blue-50/50 rounded-2xl p-2 px-4 transition-all" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">dashboard</span>
<span class="font-['Inter'] text-[11px] font-medium tracking-wide mt-1">Tổng quan</span>
</a>
<a class="flex flex-col items-center justify-center text-zinc-400 p-2 hover:text-blue-500 transition-colors" href="#">
<span class="material-symbols-outlined">group</span>
<span class="font-['Inter'] text-[11px] font-medium tracking-wide mt-1">Nhân viên</span>
</a>
<a class="flex flex-col items-center justify-center text-zinc-400 p-2 hover:text-blue-500 transition-colors" href="/ChamCong">
<span class="material-symbols-outlined">fact_check</span>
<span class="font-['Inter'] text-[11px] font-medium tracking-wide mt-1">Chấm công</span>
</a>
<a class="flex flex-col items-center justify-center text-zinc-400 p-2 hover:text-blue-500 transition-colors" href="/Chat">
<span class="material-symbols-outlined">forum</span>
<span class="font-['Inter'] text-[11px] font-medium tracking-wide mt-1">Chat</span>
</a>
<a class="flex flex-col items-center justify-center text-zinc-400 p-2 hover:text-blue-500 transition-colors" href="#">
<span class="material-symbols-outlined">settings</span>
<span class="font-['Inter'] text-[11px] font-medium tracking-wide mt-1">Cài đặt</span>
</a>
</nav>

<script>
    document.addEventListener("DOMContentLoaded", async function () {
        try {
            // Tải dữ liệu thống kê từ Backend
            const response = await fetch('/api/tongquan/thong-ke');
            if (response.ok) {
                const data = await response.json();
                if (data.success) {
                    // Đắp số liệu vào HTML thông qua ID
                    document.getElementById('txtTongNhanVien').innerText = data.tongNhanVien;
                    document.getElementById('txtTongPhongBan').innerText = data.tongPhongBan;
                    document.getElementById('txtDonChoDuyet').innerText = data.donChoDuyet;
                    document.getElementById('txtChuaChamCong').innerText = data.chuaChamCong;
                    document.getElementById('txtTyLeDungGio').innerText = data.tyLeDungGio;
                }
            }
        } catch (error) {
            console.error("Lỗi khi tải dữ liệu thống kê:", error);
        }
    });
</script>

</body></html>