@model IEnumerable<Web_quan_ly_nhan_su.Models.NghiPhep>
@{
    ViewData["Title"] = "Cài đặt & Quản trị";
    ViewData["PageHeader"] = "Cài đặt & Quản trị";
    ViewData["HideFloatingAI"] = true;

    // TỐI ƯU C#: Thêm viền mỏng (ring) để badge trạng thái trông sắc nét và cao cấp hơn
    string GetStatusStyle(string status)
    {
        return status switch
        {
            "Đã duyệt" => "bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200/60",
            "Từ chối" => "bg-red-50 text-error ring-1 ring-red-200/60",
            _ => "bg-amber-50 text-amber-700 ring-1 ring-amber-200/60" // Chờ duyệt
        };
    }
}

<link href="~/css/CaiDat.css" rel="stylesheet" />

<div class="flex gap-8 border-b border-gray-200 mb-8 px-2">
    <button id="btnTabDonTu" onclick="switchTab('dontu')" class="pb-3 text-sm font-bold text-primary border-b-2 border-primary transition-all active:scale-95">
        Quản lý Đơn từ
    </button>
    <button id="btnTabNhanSu" onclick="switchTab('nhansu')" class="pb-3 text-sm font-bold text-outline border-b-2 border-transparent hover:text-primary transition-all active:scale-95">
        Quản lý Nhân sự
    </button>
    <button id="btnTabCongTac" onclick="switchTab('congtac')" class="pb-3 text-sm font-bold text-outline border-b-2 border-transparent hover:text-primary transition-all active:scale-95">
        Lịch công tác
    </button>
</div>

<div id="tabDonTu" class="animate-in fade-in duration-300">
    <div class="flex gap-3 overflow-x-auto pb-4 no-scrollbar mb-6">
        <button onclick="filterDonTu('Tất cả', this)" class="btn-filter-dontu px-6 py-2 rounded-full bg-primary text-white text-sm font-bold whitespace-nowrap shadow-md shadow-primary/20 active:scale-95 transition-all">Tất cả</button>
        <button onclick="filterDonTu('Chờ duyệt', this)" class="btn-filter-dontu px-6 py-2 rounded-full bg-white border border-gray-200 text-outline text-sm font-bold whitespace-nowrap hover:bg-gray-50 active:scale-95 transition-all">Chờ duyệt</button>
        <button onclick="filterDonTu('Đã duyệt', this)" class="btn-filter-dontu px-6 py-2 rounded-full bg-white border border-gray-200 text-outline text-sm font-bold whitespace-nowrap hover:bg-gray-50 active:scale-95 transition-all">Đã duyệt</button>
        <button onclick="filterDonTu('Từ chối', this)" class="btn-filter-dontu px-6 py-2 rounded-full bg-white border border-gray-200 text-outline text-sm font-bold whitespace-nowrap hover:bg-gray-50 active:scale-95 transition-all">Từ chối</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="listDonTuContainer">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="dontu-item bg-white p-6 rounded-[28px] shadow-sm hover:shadow-xl border border-gray-100 hover:border-primary/20 transform hover:-translate-y-1 transition-all duration-300 group" data-status="@item.TrangThai">

                    <div class="flex justify-between items-start mb-5">
                        <div class="p-3 bg-primary/5 rounded-2xl text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined text-[26px]">event_busy</span>
                        </div>
                        <span class="px-3.5 py-1.5 rounded-full text-[11px] font-bold uppercase tracking-wider @GetStatusStyle(item.TrangThai)">
                            @item.TrangThai
                        </span>
                    </div>

                    <h3 class="font-headline font-bold text-xl text-gray-900 mb-2">@item.LoaiNghi</h3>

                    <div class="flex justify-between items-center mb-6 gap-3 min-h-[40px]">
                        <p class="text-outline text-sm line-clamp-2 flex-1 leading-relaxed" title="@item.LyDo">@item.LyDo</p>

                        @if (!string.IsNullOrEmpty(item.MinhChungUrl))
                        {
                            <a href="@item.MinhChungUrl" target="_blank" class="w-10 h-10 rounded-full bg-blue-50 text-primary hover:bg-primary hover:text-white hover:shadow-lg flex items-center justify-center transition-all shrink-0" title="Xem file minh chứng">
                                <span class="material-symbols-outlined text-[20px]">attachment</span>
                            </a>
                        }
                    </div>

                    <div class="flex items-center gap-3 pt-5 border-t border-gray-100">
                        <img alt="@(item.NhanVien?.HoTen ?? "User")" class="w-11 h-11 rounded-full object-cover ring-2 ring-white shadow-sm" src="@(item.NhanVien?.AnhDaiDien ?? "/images/avatar_default.jpg")" />
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-bold text-gray-900 truncate">@(item.NhanVien?.HoTen ?? "Không xác định")</p>
                            <p class="text-[11px] font-medium text-outline mt-0.5">@item.NgayBatDau.ToString("dd/MM") - @item.NgayKetThuc.ToString("dd/MM/yyyy")</p>
                        </div>

                        @if (item.TrangThai == "Chờ duyệt")
                        {
                            <div class="flex gap-2 shrink-0">
                                <button onclick="xuLyDonTu(@item.Id, 'Đã duyệt')" class="w-10 h-10 md:w-auto md:px-4 md:py-2 rounded-xl bg-emerald-50 text-emerald-600 hover:bg-emerald-500 hover:text-white flex items-center justify-center gap-1.5 font-bold text-xs transition-all active:scale-90" title="Duyệt đơn">
                                    <span class="material-symbols-outlined text-[18px]">check_circle</span> <span class="hidden md:inline">Duyệt</span>
                                </button>
                                <button onclick="xuLyDonTu(@item.Id, 'Từ chối')" class="w-10 h-10 md:w-auto md:px-4 md:py-2 rounded-xl bg-red-50 text-error hover:bg-error hover:text-white flex items-center justify-center gap-1.5 font-bold text-xs transition-all active:scale-90" title="Từ chối">
                                    <span class="material-symbols-outlined text-[18px]">cancel</span> <span class="hidden md:inline">Từ chối</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-gray-300">task_alt</span>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-1 md:col-span-2 py-20 flex flex-col items-center justify-center text-outline bg-white rounded-[32px] border border-dashed border-gray-200">
                <span class="material-symbols-outlined text-5xl mb-3 opacity-20">inbox</span>
                <p class="font-medium text-sm">Hiện chưa có đơn từ nào được gửi đến.</p>
            </div>
        }

        <div id="emptyFilterMsg" class="col-span-1 md:col-span-2 py-20 flex flex-col items-center justify-center text-outline bg-white rounded-[32px] border border-dashed border-gray-200" style="display: none;">
            <span class="material-symbols-outlined text-5xl mb-3 opacity-20">filter_list_off</span>
            <p class="font-medium text-sm">Không có đơn từ nào thuộc trạng thái này.</p>
        </div>
    </div>
</div>

<div id="tabNhanSu" class="hidden animate-in fade-in duration-300">
    <div class="bg-white rounded-[32px] shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-6 border-b border-gray-100 flex flex-col md:flex-row justify-between items-center gap-5 bg-gray-50/30">
            <div class="flex flex-col md:flex-row md:items-center gap-4 w-full md:w-auto">
                <h3 class="font-headline font-bold text-xl text-gray-900 whitespace-nowrap">Danh sách nhân sự</h3>
                <div class="relative w-full md:w-72 group">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">search</span>
                    <input id="txtSearchNhanVien" type="text" class="w-full bg-white border border-gray-200 rounded-full pl-12 pr-4 py-2.5 text-sm font-medium focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none transition-all shadow-sm" placeholder="Tìm tên, email..." />
                </div>
            </div>

            <button onclick="openAddUserModal()" class="w-full md:w-auto bg-primary text-white px-6 py-3 rounded-full text-sm font-bold shadow-lg shadow-primary/20 hover:bg-primary-container active:scale-95 flex items-center justify-center gap-2 transition-all">
                <span class="material-symbols-outlined text-[20px]">person_add</span> Thêm Nhân viên
            </button>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50/50 text-outline text-xs uppercase tracking-wider border-b border-gray-100">
                        <th class="px-6 py-4 font-bold">Nhân viên</th>
                        <th class="px-6 py-4 font-bold">Phòng ban</th>
                        <th class="px-6 py-4 font-bold">Trạng thái & Vai trò</th>
                        <th class="px-6 py-4 font-bold text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="tableNhanVien" class="divide-y divide-gray-100">
                    <tr><td colspan="4" class="p-12 text-center text-outline animate-pulse font-medium">Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="tabCongTac" class="hidden animate-in fade-in duration-300">
    <div class="bg-white rounded-[32px] shadow-sm border border-gray-100 overflow-hidden p-6">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-8">
            <div>
                <h3 class="font-headline font-bold text-xl text-gray-900">Kế hoạch công tác</h3>
                <p class="text-sm text-outline mt-1">Quản lý và sắp xếp lịch đi công tác cho nhân sự</p>
            </div>
            <button onclick="openAddCongTacModal()" class="w-full md:w-auto bg-primary text-white px-6 py-3 rounded-full text-sm font-bold shadow-lg shadow-primary/20 hover:bg-primary-container active:scale-95 flex items-center justify-center gap-2 transition-all">
                <span class="material-symbols-outlined text-[20px]">add_location_alt</span> Thêm lịch mới
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="listCongTacContainer">
            <div class="col-span-full text-center py-10 text-outline animate-pulse">Đang tải danh sách lịch công tác...</div>
        </div>
    </div>
</div>

<div id="modalAddCongTac" class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-md z-[100] flex items-center justify-center p-4 transition-all">
    <div class="bg-white rounded-[32px] shadow-2xl w-full max-w-lg p-8 flex flex-col gap-6 transform scale-95 animate-in zoom-in-95 duration-200">
        <div class="flex justify-between items-center">
            <div>
                <h2 class="font-headline font-bold text-2xl text-gray-900">Xếp lịch công tác</h2>
                <p class="text-xs text-outline mt-1">Lên kế hoạch đi công tác cho nhân sự</p>
            </div>
            <button onclick="closeCongTacModal()" class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-outline hover:bg-red-50 hover:text-error transition-colors active:scale-90"><span class="material-symbols-outlined">close</span></button>
        </div>

        <div class="space-y-4">
            <div>
                <label class="text-[11px] font-bold text-outline uppercase tracking-wider mb-1.5 block ml-1">Chọn nhân viên</label>
                <select id="selNhanVienCongTac" class="w-full bg-gray-50/50 border border-gray-200 rounded-2xl px-5 py-3.5 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm font-medium outline-none transition-all cursor-pointer">
                    <option value="">-- Đang tải danh sách --</option>
                </select>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="text-[11px] font-bold text-outline uppercase tracking-wider mb-1.5 block ml-1">Ngày bắt đầu</label>
                    <input type="date" id="dateStartCT" class="w-full bg-gray-50/50 border border-gray-200 rounded-2xl px-5 py-3.5 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm font-medium outline-none transition-all">
                </div>
                <div>
                    <label class="text-[11px] font-bold text-outline uppercase tracking-wider mb-1.5 block ml-1">Ngày kết thúc</label>
                    <input type="date" id="dateEndCT" class="w-full bg-gray-50/50 border border-gray-200 rounded-2xl px-5 py-3.5 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm font-medium outline-none transition-all">
                </div>
            </div>
            <div>
                <label class="text-[11px] font-bold text-outline uppercase tracking-wider mb-1.5 block ml-1">Địa điểm & Mục đích</label>
                <textarea id="txtMucDichCT" rows="3" class="w-full bg-gray-50/50 border border-gray-200 rounded-2xl px-5 py-3.5 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm font-medium outline-none transition-all" placeholder="Vd: Hà Nội - Gặp gỡ và ký kết với đối tác ABC..."></textarea>
            </div>

            <div>
                <label class="text-[11px] font-bold text-outline uppercase tracking-wider mb-1.5 block ml-1">File tài liệu đính kèm (Tùy chọn)</label>
                <input type="file" id="fileCongTac" accept=".pdf,.doc,.docx" class="w-full bg-gray-50/50 border border-gray-200 rounded-2xl px-4 py-2 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm font-medium outline-none transition-all file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-bold file:bg-primary/10 file:text-primary hover:file:bg-primary/20 cursor-pointer">
            </div>
        </div>

        <button onclick="submitAddCongTac()" id="btnSubmitCongTac" class="w-full bg-primary text-white py-4 rounded-full font-bold shadow-lg shadow-primary/30 hover:bg-primary-container active:scale-95 transition-all mt-2 flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-[20px]">save</span> Lưu lịch công tác
        </button>
    </div>
</div>

<div id="modalAddUser" class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-md z-[100] flex items-center justify-center p-4 transition-all">
    <div class="bg-white rounded-[32px] shadow-2xl w-full max-w-md p-8 flex flex-col gap-6 transform scale-95 animate-in zoom-in-95 duration-200">
        <div class="flex justify-between items-center">
            <div>
                <h2 class="font-headline font-bold text-2xl text-gray-900">Thêm Nhân viên</h2>
                <p class="text-xs text-outline mt-1">Cấp tài khoản mới cho nhân sự</p>
            </div>
            <button onclick="closeAddUserModal()" class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-outline hover:bg-red-50 hover:text-error transition-colors active:scale-90"><span class="material-symbols-outlined">close</span></button>
        </div>
        <div class="space-y-4">
            <div>
                <label class="text-[11px] font-bold text-outline uppercase tracking-wider mb-1.5 block ml-1">Họ và tên</label>
                <input id="txtAddHoTen" type="text" class="w-full bg-gray-50/50 border border-gray-200 rounded-2xl px-5 py-3.5 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm font-medium outline-none transition-all" placeholder="Vd: Nguyễn Văn A">
            </div>
            <div>
                <label class="text-[11px] font-bold text-outline uppercase tracking-wider mb-1.5 block ml-1">Địa chỉ Email</label>
                <input id="txtAddEmail" type="email" class="w-full bg-gray-50/50 border border-gray-200 rounded-2xl px-5 py-3.5 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm font-medium outline-none transition-all" placeholder="example@congty.com">
            </div>
            <div>
                <label class="text-[11px] font-bold text-outline uppercase tracking-wider mb-1.5 block ml-1">Mật khẩu khởi tạo</label>
                <input id="txtAddMatKhau" type="password" class="w-full bg-gray-50/50 border border-gray-200 rounded-2xl px-5 py-3.5 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm font-medium outline-none transition-all" placeholder="Nhập mật khẩu an toàn">
            </div>
        </div>
        <button onclick="submitAddUser()" id="btnSubmitAddUser" class="w-full bg-primary text-white py-4 rounded-full font-bold shadow-lg shadow-primary/30 hover:bg-primary-container active:scale-95 transition-all mt-2">
            Xác nhận tạo
        </button>
    </div>
</div>

<div id="modalEditRole" class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-md z-[100] flex items-center justify-center p-4 transition-all">
    <div class="bg-white rounded-[32px] shadow-2xl w-full max-w-md p-8 flex flex-col gap-6 transform scale-95 animate-in zoom-in-95 duration-200">
        <div class="flex justify-between items-center">
            <div>
                <h2 class="font-headline font-bold text-2xl text-gray-900">Phân quyền</h2>
                <p class="text-xs text-outline mt-1">Cập nhật phòng ban & vai trò</p>
            </div>
            <button onclick="closeModal()" class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-outline hover:bg-red-50 hover:text-error transition-colors active:scale-90"><span class="material-symbols-outlined">close</span></button>
        </div>
        <div class="space-y-5">
            <div>
                <label class="text-[11px] font-bold text-outline uppercase tracking-wider mb-1.5 block ml-1">Trực thuộc Phòng Ban</label>
                <select id="selPhongBan" class="w-full bg-gray-50/50 border border-gray-200 rounded-2xl px-5 py-3.5 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm font-medium outline-none transition-all cursor-pointer">
                    <option value="">-- Chưa phân bổ --</option>
                </select>
            </div>
            <div>
                <label class="text-[11px] font-bold text-outline uppercase tracking-wider mb-1.5 block ml-1">Vai trò hệ thống</label>
                <div id="boxVaiTros" class="flex flex-col gap-2 max-h-52 overflow-y-auto bg-gray-50/50 p-3 border border-gray-200 rounded-2xl custom-scrollbar">
                </div>
            </div>
        </div>
        <button onclick="submitUpdateRole()" class="w-full bg-primary text-white py-4 rounded-full font-bold shadow-lg shadow-primary/30 hover:bg-primary-container active:scale-95 transition-all mt-2">
            Lưu thay đổi
        </button>
    </div>
</div>

@if (ViewData["HideFloatingAI"] == null)
{
    <div class="fixed bottom-28 left-6 z-40 group">
        <div class="bg-white p-4 rounded-[24px] shadow-xl flex items-center gap-3 border border-gray-100 cursor-pointer hover:bg-primary hover:text-white transition-all duration-300 active:scale-90">
            <span class="material-symbols-outlined text-primary group-hover:text-white">smart_toy</span>
            <span class="text-sm font-bold pr-2">Hỏi Trợ lý AI</span>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/CaiDat.js"></script>
}