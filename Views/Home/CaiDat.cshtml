@{
    ViewData["Title"] = "Cài đặt & Quản trị";
    ViewData["PageHeader"] = "Cài đặt & Quản trị";
    ViewData["HideFloatingAI"] = true;
}

<div class="flex gap-6 border-b border-surface-container mb-8 px-2">
    <button id="btnTabDonTu" onclick="switchTab('dontu')" class="pb-3 text-sm font-bold text-primary border-b-2 border-primary transition-all">
        Quản lý Đơn từ
    </button>
    <button id="btnTabNhanSu" onclick="switchTab('nhansu')" class="pb-3 text-sm font-bold text-outline border-b-2 border-transparent hover:text-primary transition-all">
        Quản lý Nhân sự
    </button>
</div>

<div id="tabDonTu">
    <div class="flex gap-2 overflow-x-auto pb-4 no-scrollbar mb-8">
        <button class="px-6 py-2.5 rounded-full bg-primary text-white font-medium whitespace-nowrap shadow-lg shadow-primary/20">Tất cả</button>
        <button class="px-6 py-2.5 rounded-full bg-surface-container-low text-secondary font-medium whitespace-nowrap hover:bg-surface-container-high transition-colors">Chờ duyệt</button>
        <button class="px-6 py-2.5 rounded-full bg-surface-container-low text-secondary font-medium whitespace-nowrap hover:bg-surface-container-high transition-colors">Đã duyệt</button>
        <button class="px-6 py-2.5 rounded-full bg-surface-container-low text-secondary font-medium whitespace-nowrap hover:bg-surface-container-high transition-colors">Từ chối</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-surface-container-lowest p-6 rounded-[32px] shadow-[0_20px_40px_rgba(0,0,0,0.04)] hover:shadow-[0_24px_48px_rgba(0,0,0,0.08)] transition-all group border border-transparent hover:border-primary/5">
            <div class="flex justify-between items-start mb-6">
                <div class="p-3 bg-blue-50 rounded-2xl text-primary">
                    <span class="material-symbols-outlined text-[28px]">event_busy</span>
                </div>
                <span class="px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-50 text-amber-700">Chờ duyệt</span>
            </div>
            <h3 class="font-headline font-bold text-xl mb-1">Đơn nghỉ phép</h3>
            <p class="text-secondary text-sm mb-6">Nghỉ phép năm • 2 ngày (14/10 - 15/10)</p>
            <div class="flex items-center gap-3 pt-6 border-t border-surface-container">
                <img alt="Lê Thị Mai" class="w-8 h-8 rounded-full object-cover" src="/images/avatar_default.jpg" />
                <div class="flex-1">
                    <p class="text-xs font-semibold text-on-surface">Lê Thị Mai</p>
                    <p class="text-[10px] text-outline">Phòng Marketing</p>
                </div>
                <span class="material-symbols-outlined text-outline group-hover:text-primary transition-colors">arrow_forward_ios</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-6 rounded-[32px] shadow-[0_20px_40px_rgba(0,0,0,0.04)] hover:shadow-[0_24px_48px_rgba(0,0,0,0.08)] transition-all group border border-transparent hover:border-primary/5">
            <div class="flex justify-between items-start mb-6">
                <div class="p-3 bg-emerald-50 rounded-2xl text-emerald-600">
                    <span class="material-symbols-outlined text-[28px]">flight_takeoff</span>
                </div>
                <span class="px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700">Đã duyệt</span>
            </div>
            <h3 class="font-headline font-bold text-xl mb-1">Đơn công tác</h3>
            <p class="text-secondary text-sm mb-6">Công tác Hà Nội • 5 ngày (20/10 - 25/10)</p>
            <div class="flex items-center gap-3 pt-6 border-t border-surface-container">
                <img alt="Trần Minh Tâm" class="w-8 h-8 rounded-full object-cover" src="/images/avatar_default.jpg" />
                <div class="flex-1">
                    <p class="text-xs font-semibold text-on-surface">Trần Minh Tâm</p>
                    <p class="text-[10px] text-outline">Phòng Kinh doanh</p>
                </div>
                <span class="material-symbols-outlined text-outline group-hover:text-primary transition-colors">arrow_forward_ios</span>
            </div>
        </div>
    </div>
</div>

<div id="tabNhanSu" class="hidden">
    <div class="bg-white rounded-[32px] shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-6 border-b border-gray-100 flex flex-col md:flex-row justify-between items-center gap-4 bg-gray-50/50">
            <div class="flex items-center gap-4 w-full md:w-auto">
                <h3 class="font-headline font-bold text-lg whitespace-nowrap">Danh sách nhân sự</h3>
                
                <div class="relative w-full md:w-64">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-outline text-[20px]">search</span>
                    <input id="txtSearchNhanVien" type="text" class="w-full bg-white border border-gray-200 rounded-2xl pl-10 pr-4 py-2 text-sm font-medium focus:ring-2 focus:ring-primary outline-none transition-all" placeholder="Tìm tên, email..." />
                </div>
            </div>

            <button onclick="openAddUserModal()" class="bg-primary text-white px-4 py-2 rounded-xl text-sm font-bold shadow-md hover:bg-primary/90 flex items-center gap-2 whitespace-nowrap">
                <span class="material-symbols-outlined text-[18px]">person_add</span> Thêm NV
            </button>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 text-outline text-xs uppercase tracking-wider">
                        <th class="p-4 font-bold">Nhân viên</th>
                        <th class="p-4 font-bold">Phòng ban</th>
                        <th class="p-4 font-bold">Trạng thái & Vai trò</th>
                        <th class="p-4 font-bold text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="tableNhanVien" class="divide-y divide-gray-100">
                    <tr><td colspan="4" class="p-8 text-center text-outline animate-pulse">Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="modalAddUser" class="hidden fixed inset-0 bg-black/60 z-[100] flex items-center justify-center p-4 backdrop-blur-sm transition-all">
    <div class="bg-white rounded-[32px] shadow-2xl w-full max-w-md p-6 flex flex-col gap-5">
        <div class="flex justify-between items-center mb-2">
            <h2 class="font-headline font-bold text-xl">Thêm Nhân viên mới</h2>
            <button onclick="closeAddUserModal()" class="text-outline hover:text-error transition-colors"><span class="material-symbols-outlined">close</span></button>
        </div>
        
        <div>
            <label class="text-xs font-bold text-outline uppercase tracking-wider mb-2 block">Họ và tên</label>
            <input id="txtAddHoTen" type="text" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 focus:ring-2 focus:ring-primary text-sm font-medium outline-none" placeholder="Nhập họ và tên...">
        </div>

        <div>
            <label class="text-xs font-bold text-outline uppercase tracking-wider mb-2 block">Địa chỉ Email</label>
            <input id="txtAddEmail" type="email" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 focus:ring-2 focus:ring-primary text-sm font-medium outline-none" placeholder="example@congty.com">
        </div>

        <div>
            <label class="text-xs font-bold text-outline uppercase tracking-wider mb-2 block">Mật khẩu</label>
            <input id="txtAddMatKhau" type="password" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 focus:ring-2 focus:ring-primary text-sm font-medium outline-none" placeholder="Nhập mật khẩu (sẽ được mã hóa)">
        </div>

        <button onclick="submitAddUser()" id="btnSubmitAddUser" class="w-full bg-primary text-white py-4 rounded-2xl font-bold shadow-lg shadow-primary/30 mt-2 hover:bg-primary/90 transition-colors">
            Tạo tài khoản
        </button>
    </div>
</div>

<div id="modalEditRole" class="hidden fixed inset-0 bg-black/60 z-[100] flex items-center justify-center p-4 backdrop-blur-sm transition-all">
    <div class="bg-white rounded-[32px] shadow-2xl w-full max-w-md p-6 flex flex-col gap-5">
        <div class="flex justify-between items-center mb-2">
            <h2 class="font-headline font-bold text-xl">Phân quyền Nhân sự</h2>
            <button onclick="closeModal()" class="text-outline hover:text-error transition-colors"><span class="material-symbols-outlined">close</span></button>
        </div>
        
        <div>
            <label class="text-xs font-bold text-outline uppercase tracking-wider mb-2 block">Thuộc Phòng Ban</label>
            <select id="selPhongBan" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3 focus:ring-2 focus:ring-primary text-sm font-medium outline-none">
                <option value="">-- Chưa phân bổ --</option>
            </select>
        </div>

        <div>
            <label class="text-xs font-bold text-outline uppercase tracking-wider mb-2 block">Vai trò đảm nhiệm</label>
            <div id="boxVaiTros" class="flex flex-col gap-2 max-h-48 overflow-y-auto bg-gray-50 p-4 border border-gray-200 rounded-2xl">
            </div>
        </div>

        <button onclick="submitUpdateRole()" class="w-full bg-primary text-white py-4 rounded-2xl font-bold shadow-lg shadow-primary/30 mt-2 hover:bg-primary/90 transition-colors">
            Lưu Cập Nhật
        </button>
    </div>
</div>

<div class="fixed bottom-28 left-6 z-40 group">
    <div class="bg-white p-4 rounded-3xl shadow-xl flex items-center gap-3 border border-primary/5 cursor-pointer hover:bg-primary-container hover:text-white transition-all">
        <span class="material-symbols-outlined text-primary group-hover:text-white">smart_toy</span>
        <span class="text-sm font-medium pr-2">Hỏi Trợ lý AI</span>
    </div>
</div>

<script>
    let masterData = { phongBans: [], vaiTros: [] };
    let editingUserId = null;

    function switchTab(tab) {
        if(tab === 'dontu') {
            document.getElementById('tabDonTu').classList.remove('hidden');
            document.getElementById('tabNhanSu').classList.add('hidden');
            document.getElementById('btnTabDonTu').className = "pb-3 text-sm font-bold text-primary border-b-2 border-primary transition-all";
            document.getElementById('btnTabNhanSu').className = "pb-3 text-sm font-bold text-outline border-b-2 border-transparent hover:text-primary transition-all";
        } else {
            document.getElementById('tabDonTu').classList.add('hidden');
            document.getElementById('tabNhanSu').classList.remove('hidden');
            document.getElementById('btnTabDonTu').className = "pb-3 text-sm font-bold text-outline border-b-2 border-transparent hover:text-primary transition-all";
            document.getElementById('btnTabNhanSu').className = "pb-3 text-sm font-bold text-primary border-b-2 border-primary transition-all";
            loadNhanVienData();
        }
    }

    async function loadMasterData() {
        try {
            const res = await fetch('/api/quanlynhanvien/master-data');
            const data = await res.json();
            if(data.success) {
                masterData = data;
                const selPb = document.getElementById('selPhongBan');
                selPb.innerHTML = '<option value="">-- Chưa phân bổ --</option>';
                data.phongBans.forEach(p => {
                    selPb.insertAdjacentHTML('beforeend', `<option value="${p.maPhongBan}">${p.tenPhongBan}</option>`);
                });
            }
        } catch(e) { console.error(e); }
    }

    // ĐÃ SỬA: Hàm Load danh sách có thêm tham số searchQuery
    async function loadNhanVienData(searchQuery = "") {
        const tbody = document.getElementById('tableNhanVien');
        tbody.innerHTML = '<tr><td colspan="4" class="p-8 text-center text-outline animate-pulse">Đang tải dữ liệu...</td></tr>';
        
        if (masterData.phongBans.length === 0) await loadMasterData();

        try {
            const res = await fetch(`/api/quanlynhanvien/danh-sach?q=${encodeURIComponent(searchQuery)}`);
            const data = await res.json();
            if(data.success) {
                tbody.innerHTML = '';
                
                if (data.data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="4" class="p-8 text-center text-outline">Không tìm thấy nhân sự phù hợp.</td></tr>';
                    return;
                }

                data.data.forEach(nv => {
                    let statusHtml = (!nv.trangThai || nv.trangThai === 1)
                        ? '<span class="bg-emerald-50 text-emerald-600 px-2 py-0.5 rounded-md text-[10px] font-bold border border-emerald-100 mb-1 inline-block">Đang hoạt động</span>'
                        : '<span class="bg-red-50 text-error px-2 py-0.5 rounded-md text-[10px] font-bold border border-red-100 mb-1 inline-block">Đã khóa</span>';

                    let rolesHtml = nv.vaiTros.map(v => `<span class="bg-blue-50 text-primary px-2 py-0.5 rounded-md text-[10px] font-bold border border-blue-100 inline-block">${v.tenVaiTro}</span>`).join(' ');
                    if(!rolesHtml) rolesHtml = '<span class="text-xs text-outline italic inline-block">Chưa cấp quyền</span>';

                    const currentRolesStr = JSON.stringify(nv.vaiTros.map(v => v.maVaiTro));
                    const isLocked = nv.trangThai === 0;
                    const lockIcon = isLocked ? 'lock_open' : 'lock';
                    const lockClass = isLocked ? 'bg-emerald-50 text-emerald-600 hover:bg-emerald-500' : 'bg-red-50 text-error hover:bg-error';
                    const lockTitle = isLocked ? 'Mở khóa tài khoản' : 'Khóa tài khoản (Chặn đăng nhập)';
                    const lockActionName = isLocked ? 'MỞ KHÓA' : 'KHÓA';

                    const tr = `
                    <tr class="hover:bg-gray-50 transition-colors ${isLocked ? 'opacity-60' : ''}">
                        <td class="p-4">
                            <div class="flex items-center gap-3">
                                <img src="${nv.anhDaiDien || '/images/avatar_default.jpg'}" class="w-10 h-10 rounded-full object-cover shadow-sm ${isLocked ? 'grayscale' : ''}"/>
                                <div>
                                    <p class="text-sm font-bold text-gray-900">${nv.hoTen}</p>
                                    <p class="text-[11px] text-outline">${nv.email}</p>
                                </div>
                            </div>
                        </td>
                        <td class="p-4 text-sm font-medium text-gray-700">${nv.tenPhongBan}</td>
                        <td class="p-4">
                            ${statusHtml}<br/>
                            <div class="flex flex-wrap gap-1 mt-1">${rolesHtml}</div>
                        </td>
                        <td class="p-4 text-right">
                            <button onclick="openEditModal(${nv.maNhanVien}, ${nv.maPhongBan || 'null'}, ${currentRolesStr})" class="w-8 h-8 rounded-lg bg-blue-50 text-primary hover:bg-primary hover:text-white transition-colors inline-flex items-center justify-center mr-1" title="Sửa quyền">
                                <span class="material-symbols-outlined text-[18px]">edit</span>
                            </button>
                            <button onclick="toggleLockStatus(${nv.maNhanVien}, '${nv.hoTen}', '${lockActionName}')" class="w-8 h-8 rounded-lg ${lockClass} hover:text-white transition-colors inline-flex items-center justify-center" title="${lockTitle}">
                                <span class="material-symbols-outlined text-[18px]">${lockIcon}</span>
                            </button>
                        </td>
                    </tr>`;
                    tbody.insertAdjacentHTML('beforeend', tr);
                });
            }
        } catch(e) { console.error(e); }
    }

    // ĐÃ THÊM: Logic Tìm kiếm nhân sự có độ trễ (Debounce)
    let searchTimeout = null;
    const txtSearch = document.getElementById('txtSearchNhanVien');
    if (txtSearch) {
        txtSearch.addEventListener('input', (e) => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                loadNhanVienData(e.target.value.trim());
            }, 400); // Đợi gõ xong 400ms mới gọi API
        });
    }

    // ================== LOGIC THÊM NHÂN VIÊN ==================
    function openAddUserModal() {
        document.getElementById('txtAddHoTen').value = '';
        document.getElementById('txtAddEmail').value = '';
        document.getElementById('txtAddMatKhau').value = '';
        document.getElementById('modalAddUser').classList.remove('hidden');
    }

    function closeAddUserModal() {
        document.getElementById('modalAddUser').classList.add('hidden');
    }

    async function submitAddUser() {
        const hoTen = document.getElementById('txtAddHoTen').value.trim();
        const email = document.getElementById('txtAddEmail').value.trim();
        const matKhau = document.getElementById('txtAddMatKhau').value.trim();

        if(!hoTen || !email || !matKhau) {
            alert("Vui lòng điền đầy đủ Họ tên, Email và Mật khẩu!");
            return;
        }

        const btnSubmit = document.getElementById('btnSubmitAddUser');
        btnSubmit.disabled = true;
        btnSubmit.innerText = "Đang xử lý...";

        const payload = { hoTen: hoTen, email: email, matKhau: matKhau };

        try {
            const res = await fetch('/api/quanlynhanvien/them', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            
            if(data.success) {
                alert(data.message);
                closeAddUserModal();
                loadNhanVienData(document.getElementById('txtSearchNhanVien').value.trim());
            } else {
                alert(data.message);
            }
        } catch(e) {
            console.error(e);
            alert("Đã xảy ra lỗi khi kết nối server!");
        } finally {
            btnSubmit.disabled = false;
            btnSubmit.innerText = "Tạo tài khoản";
        }
    }

    // ================== LOGIC CẬP NHẬT QUYỀN ==================
    function openEditModal(id, maPhongBan, currentRoles) {
        editingUserId = id;
        document.getElementById('selPhongBan').value = maPhongBan || "";
        
        const box = document.getElementById('boxVaiTros');
        box.innerHTML = '';
        masterData.vaiTros.forEach(vt => {
            const isChecked = currentRoles.includes(vt.maVaiTro) ? 'checked' : '';
            box.insertAdjacentHTML('beforeend', `
                <label class="flex items-center gap-3 p-2 rounded-xl hover:bg-white cursor-pointer transition-colors border border-transparent hover:border-gray-200 shadow-sm">
                    <input type="checkbox" value="${vt.maVaiTro}" class="role-checkbox w-5 h-5 text-primary rounded border-gray-300 focus:ring-primary" ${isChecked}>
                    <span class="text-sm font-bold text-gray-700">${vt.tenVaiTro}</span>
                </label>
            `);
        });

        document.getElementById('modalEditRole').classList.remove('hidden');
    }

    function closeModal() {
        document.getElementById('modalEditRole').classList.add('hidden');
        editingUserId = null;
    }

    async function submitUpdateRole() {
        if(!editingUserId) return;
        
        const maPhongBan = document.getElementById('selPhongBan').value;
        const roleCheckboxes = document.querySelectorAll('.role-checkbox:checked');
        const maVaiTros = Array.from(roleCheckboxes).map(cb => parseInt(cb.value));

        const payload = {
            maPhongBan: maPhongBan ? parseInt(maPhongBan) : null,
            maVaiTros: maVaiTros
        };

        try {
            const res = await fetch(`/api/quanlynhanvien/cap-nhat/${editingUserId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if(data.success) {
                alert("Cập nhật thành công!");
                closeModal();
                loadNhanVienData(document.getElementById('txtSearchNhanVien').value.trim());
            } else alert("Lỗi: " + data.message);
        } catch(e) { console.error(e); }
    }

    // ================== LOGIC KHÓA TÀI KHOẢN ==================
    async function toggleLockStatus(id, name, actionName) {
        if(!confirm(`XÁC NHẬN: Bạn muốn ${actionName} tài khoản của [${name}]?`)) return;

        try {
            const res = await fetch(`/api/quanlynhanvien/toggle-status/${id}`, { method: 'PUT' });
            const data = await res.json();
            alert(data.message);
            if(data.success) loadNhanVienData(document.getElementById('txtSearchNhanVien').value.trim());
        } catch(e) { console.error(e); }
    }
</script>