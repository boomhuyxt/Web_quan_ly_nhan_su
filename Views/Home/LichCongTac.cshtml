@{
    ViewData["Title"] = "Lịch công tác";
    ViewData["PageHeader"] = "Theo dõi Lịch công tác";
}

<link href="~/css/TheoDoiCongTac.css" rel="stylesheet" />

<div class="mb-4">
    <a href="/Home/Index" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-bold text-outline bg-white border border-gray-200 rounded-full hover:text-primary hover:border-primary/30 hover:shadow-md transition-all active:scale-95 w-fit">
        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
        Quay lại Tổng quan
    </a>
</div>

<div class="mb-8 flex flex-col md:flex-row justify-between items-center gap-4 bg-white p-6 rounded-[32px] shadow-sm border border-gray-100">
    <div>
        <h2 class="font-headline font-bold text-2xl text-gray-900">Danh sách Lịch Công Tác</h2>
        <p class="text-sm text-outline mt-1">Theo dõi kế hoạch và tài liệu phân công nhiệm vụ</p>
    </div>

    <div class="flex gap-2 bg-gray-50/80 p-1.5 rounded-full border border-gray-200/60 shadow-inner overflow-x-auto no-scrollbar">
        <button onclick="filterCongTac('Tất cả', this)" class="btn-filter-ct px-5 py-2 rounded-full bg-primary text-white text-sm font-bold transition-all shadow-md whitespace-nowrap">Tất cả</button>
        <button onclick="filterCongTac('Sắp tới', this)" class="btn-filter-ct px-5 py-2 rounded-full bg-transparent text-outline hover:text-gray-900 text-sm font-bold transition-all whitespace-nowrap">Sắp tới</button>
        <button onclick="filterCongTac('Đang diễn ra', this)" class="btn-filter-ct px-5 py-2 rounded-full bg-transparent text-outline hover:text-gray-900 text-sm font-bold transition-all whitespace-nowrap">Đang diễn ra</button>
        <button onclick="filterCongTac('Đã hoàn thành', this)" class="btn-filter-ct px-5 py-2 rounded-full bg-transparent text-outline hover:text-gray-900 text-sm font-bold transition-all whitespace-nowrap">Đã hoàn thành</button>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="viewCongTacContainer">
    <div class="col-span-full py-20 text-center animate-pulse text-outline bg-white rounded-[32px] border border-gray-100 shadow-sm">
        <span class="material-symbols-outlined text-4xl mb-2 opacity-50">hourglass_empty</span>
        <p class="font-medium">Đang đồng bộ dữ liệu lịch công tác...</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/TheoDoiCongTac.js"></script>
}