@using System.Security.Claims
<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Atelier HR - Chat nội bộ</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        colors: {
        "outline": "#717786",
        "primary": "#0058bc",
        "surface-container": "#eeeef0",
        "surface-container-lowest": "#ffffff",
        "surface-container-high": "#e8e8ea",
        "error": "#ba1a1a",
        "tertiary": "#006b27",
        },
        fontFamily: {
        "headline": ["Be Vietnam Pro"],
        "body": ["Inter"]
        }
        }
        }
        }
    </script>
    <style>
        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        /* Thanh cuộn mượt cho danh sách chat */
        .chat-scroll::-webkit-scrollbar {
        width: 6px;
        }

        .chat-scroll::-webkit-scrollbar-track {
        background: transparent;
        }

        .chat-scroll::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 10px;
        }

        .no-scrollbar::-webkit-scrollbar {
        display: none;
        }

        body {
        min-height: max(884px, 100dvh);
        }

        /* 👉 ĐÃ CẬP NHẬT: Khống chế chiều cao hiển thị vừa vặn khoảng 5 tài khoản và bật cuộn chuột */
        #userList {
        max-height: 440px; /* Chiều cao chuẩn cho 5 item (mỗi item khoảng 88px bao gồm khoảng cách) */
        overflow-y: auto;
        }
    </style>
</head>
<body class="bg-surface font-body text-on-surface antialiased"
      id="chatConfigContext"
      data-my-id="@User.FindFirst(ClaimTypes.NameIdentifier)?.Value">

    <div id="toastContainer" class="fixed top-24 right-6 z-[200] flex flex-col gap-3 pointer-events-none"></div>

    <main class="pt-20 pb-32 min-h-screen flex flex-col md:flex-row max-w-7xl mx-auto px-4 md:px-6 gap-6">
        <aside class="w-full md:w-[380px] flex flex-col gap-4">
            <div class="flex items-center gap-2">
                <div class="flex-1 bg-surface-container-low rounded-[32px] p-2 flex items-center gap-3 px-4 h-14 border bg-gray-100">
                    <span class="material-symbols-outlined text-outline">search</span>
                    <input id="txtSearchUser" class="bg-transparent border-none focus:ring-0 w-full text-sm font-medium" placeholder="Tìm kiếm hội thoại..." type="text" />
                </div>
                <button id="btnOpenCreateGroup" class="w-14 h-14 bg-primary text-white rounded-[24px] flex items-center justify-center hover:opacity-90 transition-opacity shadow-md" title="Tạo nhóm chat">
                    <span class="material-symbols-outlined text-[28px]">group_add</span>
                </button>
            </div>

            <div class="flex bg-gray-100 p-1.5 rounded-[20px] gap-1">
                <button id="tab-all" onclick="switchTab('all')" class="flex-1 py-2 text-[13px] font-bold rounded-2xl bg-white shadow-sm text-primary transition-all">Tất cả</button>
                <button id="tab-personal" onclick="switchTab('personal')" class="flex-1 py-2 text-[13px] font-bold rounded-2xl text-outline hover:text-on-surface transition-all">Cá nhân</button>
                <button id="tab-group" onclick="switchTab('group')" class="flex-1 py-2 text-[13px] font-bold rounded-2xl text-outline hover:text-on-surface transition-all">Nhóm</button>
            </div>

            <div id="userList" class="space-y-1 chat-scroll flex-1">
                <p class="text-center text-sm text-outline mt-8">Đang tải cuộc trò chuyện...</p>
            </div>
        </aside>

        <div id="modalGroupSettings" class="hidden fixed inset-0 bg-black/60 z-[100] flex items-center justify-center p-4 backdrop-blur-sm transition-all">
            <div class="bg-white rounded-[32px] shadow-2xl w-full max-w-md p-6 flex flex-col gap-4">
                <div class="flex justify-between items-center">
                    <h2 class="font-headline font-bold text-xl">Quản lý nhóm</h2>
                    <button onclick="closeGroupSettings()" class="text-outline hover:text-error transition-colors"><span class="material-symbols-outlined">close</span></button>
                </div>

                <div class="flex flex-col items-center justify-center gap-3">
                    <div class="relative group cursor-pointer" onclick="document.getElementById('fileUploadGroupAvatar').click()">
                        <img id="settingGroupAvatar" src="/images/avatar_default.jpg" class="w-24 h-24 rounded-full object-cover shadow-md border-4 border-white" />
                        <div class="absolute inset-0 bg-black/40 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                            <span class="material-symbols-outlined text-white">photo_camera</span>
                        </div>
                        <input type="file" id="fileUploadGroupAvatar" class="hidden" accept="image/*" />
                    </div>

                    <div id="boxDisplayName" class="flex items-center gap-2">
                        <h3 id="settingGroupName" class="font-bold text-lg">Tên nhóm</h3>
                        <button id="btnEditGroupName" onclick="enableEditGroupName()" class="hidden text-outline hover:text-primary p-1">
                            <span class="material-symbols-outlined text-[18px]">edit</span>
                        </button>
                    </div>

                    <div id="boxEditName" class="hidden flex items-center gap-2 w-full px-4">
                        <input id="txtNewGroupName" type="text" class="flex-1 bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm font-medium focus:ring-2 focus:ring-primary outline-none" />
                        <button onclick="submitUpdateGroupName()" class="text-primary material-symbols-outlined p-1 hover:bg-primary/10 rounded-full">check</button>
                        <button onclick="cancelEditGroupName()" class="text-error material-symbols-outlined p-1 hover:bg-red-50 rounded-full">close</button>
                    </div>
                </div>

                <div class="flex flex-col gap-2 mt-2">
                    <div class="flex justify-between items-center mb-1">
                        <span class="text-xs font-bold text-outline uppercase">Thành viên (<span id="countMembers">0</span>)</span>
                        <button onclick="showAddMemberBox()" class="text-[12px] font-bold text-primary flex items-center gap-1 hover:underline">
                            <span class="material-symbols-outlined text-[16px]">person_add</span> Thêm
                        </button>
                    </div>

                    <div id="boxAddMember" class="hidden flex gap-2 mb-2">
                        <input id="txtSearchNewMember" type="text" class="flex-1 bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm" placeholder="Nhập tên nhân viên..." />
                        <button onclick="submitAddMember()" class="bg-primary text-white px-3 rounded-xl text-sm font-bold">Thêm</button>
                    </div>
                    <div id="listNewMemberResults" class="hidden flex-col gap-1 max-h-32 overflow-y-auto mb-2 chat-scroll"></div>

                    <div id="listGroupMembers" class="flex flex-col gap-2 max-h-48 overflow-y-auto chat-scroll pr-2"></div>
                </div>

                <div class="flex gap-2 mt-4">
                    <button onclick="leaveGroup()" class="flex-1 bg-gray-100 text-gray-700 py-3 rounded-2xl font-bold hover:bg-gray-200 transition-colors">
                        Rời nhóm
                    </button>
                    <button id="btnDeleteGroup" onclick="deleteGroup()" class="hidden flex-1 bg-red-50 text-error py-3 rounded-2xl font-bold hover:bg-red-100 transition-colors">
                        Xóa nhóm
                    </button>
                </div>
            </div>
        </div>

        <div id="modalCreateGroup" class="hidden fixed inset-0 bg-black/60 z-[100] flex items-center justify-center p-4 backdrop-blur-sm transition-all">
            <div class="bg-white rounded-[32px] shadow-2xl w-full max-w-md p-6 flex flex-col gap-5">
                <div class="flex justify-between items-center">
                    <h2 class="font-headline font-bold text-xl">Tạo nhóm Chat mới</h2>
                    <button id="btnCloseModal" class="text-outline hover:text-error transition-colors"><span class="material-symbols-outlined">close</span></button>
                </div>

                <div>
                    <label class="text-xs font-bold text-outline uppercase tracking-wider mb-2 block">Tên nhóm</label>
                    <input id="txtGroupName" type="text" class="w-full bg-gray-100 border-none rounded-2xl px-4 py-3 focus:ring-2 focus:ring-primary text-sm font-medium" placeholder="Nhập tên nhóm..." />
                </div>

                <div class="flex flex-wrap gap-2" id="selectedMembersContainer"></div>

                <div class="relative">
                    <span class="material-symbols-outlined absolute left-4 top-3 text-outline">search</span>
                    <input id="txtSearchMember" type="text" class="w-full bg-gray-50 border border-gray-200 rounded-2xl pl-12 pr-4 py-3 focus:ring-2 focus:ring-primary text-sm font-medium" placeholder="Tìm nhân viên để thêm..." />
                </div>

                <div id="searchMemberResults" class="max-h-48 overflow-y-auto flex flex-col gap-1 chat-scroll"></div>

                <button id="btnSubmitGroup" class="w-full bg-primary text-white py-4 rounded-2xl font-bold shadow-lg shadow-primary/30 mt-2 hover:bg-primary/90 transition-colors">
                    Tạo Nhóm Ngay
                </button>
            </div>
        </div>

        <section class="flex-1 flex flex-col bg-white rounded-[40px] shadow-sm overflow-hidden border border-gray-200 h-[calc(100vh-180px)] md:h-[600px]">
            <div class="px-6 py-4 flex justify-between items-center border-b border-gray-100">
                <div id="chatHeaderBox" class="flex items-center gap-3 transition-colors rounded-xl p-1 pr-3" style="cursor: default;">
                    <img id="chatHeaderAvatar" class="w-10 h-10 rounded-full object-cover" src="/images/avatar_default.jpg" />
                    <div>
                        <h3 id="chatHeaderName" class="font-bold leading-tight">Chọn một cuộc hội thoại</h3>
                        <span id="chatHeaderStatus" class="text-[11px] text-tertiary flex items-center gap-1 font-medium">
                            <span class="w-1.5 h-1.5 bg-tertiary rounded-full animate-pulse"></span> Sẵn sàng
                        </span>
                    </div>
                </div>
                <button id="btnGroupSettings" onclick="openGroupSettings()" class="hidden w-10 h-10 rounded-full bg-gray-100 text-outline hover:bg-gray-200 hover:text-primary flex items-center justify-center transition-colors">
                    <span class="material-symbols-outlined">info</span>
                </button>
            </div>

            <div id="chatCanvas" class="flex-1 overflow-y-auto chat-scroll p-6 flex flex-col gap-6 bg-gray-50/50">
                <div class="flex h-full items-center justify-center text-outline text-sm">Hãy chọn nhân viên để trò chuyện.</div>
            </div>

            <div class="p-6 bg-white border-t border-gray-100 relative">
                <div id="uploadOverlay" class="hidden absolute inset-0 bg-white/80 z-10 flex items-center justify-center rounded-b-[40px]">
                    <span class="text-primary font-medium flex items-center gap-2">
                        <span class="material-symbols-outlined animate-spin">sync</span> Đang tải file lên...
                    </span>
                </div>

                <div class="flex items-center gap-3 bg-gray-100 rounded-3xl p-2 pl-4">
                    <button id="btnAttach" class="text-outline hover:text-primary transition-colors cursor-pointer" title="Đính kèm tài liệu (< 50MB)">
                        <span class="material-symbols-outlined">attach_file</span>
                    </button>
                    <input type="file" id="fileAttach" class="hidden" />

                    <input id="txtMessage" class="flex-1 bg-transparent border-none focus:ring-0 text-sm font-medium" placeholder="Nhập tin nhắn..." type="text" />

                    <button id="btnSend" class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center shadow-lg active:scale-90 transition-transform">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">send</span>
                    </button>
                </div>
            </div>
        </section>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/Chat.js"></script>
</body>
</html>