<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    // ==============================================================
    // LẤY ID NGƯỜI DÙNG ĐANG ĐĂNG NHẬP TỪ HỆ THỐNG
    // ==============================================================
    const userIdString = '@User.FindFirst(ClaimTypes.NameIdentifier)?.Value';
    const myId = parseInt(userIdString);

    if (isNaN(myId)) {
        alert("Phiên đăng nhập đã hết hạn hoặc bạn chưa đăng nhập!");
        window.location.href = "/Account/Login";
    }

    let friendId = null; 

    // Các phần tử DOM cần thiết
    const chatCanvas = document.getElementById('chatCanvas');
    const txtMessage = document.getElementById('txtMessage');
    const btnSend = document.getElementById('btnSend');
    const userList = document.getElementById('userList');
    const txtSearchUser = document.getElementById('txtSearchUser');
    const chatHeaderName = document.getElementById('chatHeaderName');
    const chatHeaderAvatar = document.getElementById('chatHeaderAvatar');

    // ==============================================================
    // 1. TẢI DANH SÁCH CUỘC TRÒ CHUYỆN GẦN ĐÂY (CÓ CHẤM ĐỎ)
    // ==============================================================
    async function loadRecentConversations() {
        if(isNaN(myId)) return;
        try {
            const response = await fetch(`/api/chat/conversations/${myId}`);
            if (response.ok) {
                const conversations = await response.json();
                renderConversations(conversations);
            }
        } catch (err) {
            console.error("Lỗi tải danh sách chat: ", err);
        }
    }

    function renderConversations(conversations) {
        userList.innerHTML = '';
        if (conversations.length === 0) {
            userList.innerHTML = '<p class="text-center text-sm text-outline mt-8">Chưa có cuộc trò chuyện nào.</p>';
            return;
        }

        conversations.forEach(c => {
            const avatar = c.friendAvatar || "/images/avatar_default.jpg";
            
            const redDotHtml = c.hasUnread 
                ? `<div class="absolute -top-1 -right-1 w-4 h-4 bg-error border-2 border-white rounded-full animate-pulse"></div>` 
                : '';
            
            const textClass = c.hasUnread ? 'text-on-surface font-bold' : 'text-outline font-medium';

            const html = `
            <div onclick="selectChat(${c.friendId}, '${c.friendName}', '${avatar}')" class="flex items-center gap-4 p-4 rounded-3xl hover:bg-surface-container-low transition-colors cursor-pointer border border-transparent hover:border-primary/10">
                <div class="relative">
                    <img alt="${c.friendName}" class="w-14 h-14 rounded-2xl object-cover" src="${avatar}"/>
                    ${redDotHtml}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex justify-between items-center mb-0.5">
                        <span class="font-bold text-on-surface truncate block">${c.friendName}</span>
                        <span class="text-[10px] text-outline font-medium">${c.lastMessageTime || ''}</span>
                    </div>
                    <p class="text-sm ${textClass} truncate">${c.lastMessageContent || 'Nhấn để bắt đầu chat'}</p>
                </div>
            </div>`;
            userList.insertAdjacentHTML('beforeend', html);
        });
    }

    // ==============================================================
    // 2. CHUYỂN PHÒNG CHAT & ĐÁNH DẤU ĐÃ ĐỌC
    // ==============================================================
    window.selectChat = async function(id, name, avatar) {
        friendId = id; 
        
        chatHeaderName.textContent = name;
        chatHeaderAvatar.src = avatar;
        txtMessage.value = '';

        try {
            await fetch(`/api/chat/mark-read/${myId}/${friendId}`, { method: 'POST' });
        } catch (e) { console.error(e); }

        await loadHistory();
        loadRecentConversations();
    };

    // ==============================================================
    // 3. TẢI LỊCH SỬ TIN NHẮN
    // ==============================================================
    function appendMessage(senderId, content, time, avatarUrl) {
        const isMe = senderId === myId;
        const defaultAvatar = "/images/avatar_default.jpg"; 

        let html = '';
        if (isMe) {
            html = `
            <div class="flex flex-col items-end gap-1 self-end max-w-[80%] w-full">
                <div class="bg-primary text-white p-4 rounded-2xl rounded-br-none shadow-md bg-gradient-to-br from-primary to-primary-container">
                    <p class="text-sm leading-relaxed">${content}</p>
                    <span class="text-[9px] text-primary-fixed block mt-2 text-right">${time}</span>
                </div>
            </div>`;
        } else {
            html = `
            <div class="flex items-end gap-3 max-w-[80%] w-full">
                <img alt="Avatar" class="w-8 h-8 rounded-full object-cover" src="${avatarUrl || defaultAvatar}"/>
                <div class="bg-surface-container-high text-on-surface p-4 rounded-2xl rounded-bl-none shadow-sm">
                    <p class="text-sm leading-relaxed">${content}</p>
                    <span class="text-[9px] text-outline block mt-2 text-right">${time}</span>
                </div>
            </div>`;
        }

        chatCanvas.insertAdjacentHTML('beforeend', html);
        chatCanvas.scrollTop = chatCanvas.scrollHeight;
    }

    async function loadHistory() {
        if (!friendId) return; 

        try {
            const response = await fetch(`/api/chat/history/${myId}/${friendId}`);
            if (response.ok) {
                const messages = await response.json();
                chatCanvas.innerHTML = `
                    <div class="text-center w-full">
                        <span class="px-3 py-1 bg-surface-container-high rounded-full text-[10px] font-bold text-outline tracking-wider">LỊCH SỬ TRÒ CHUYỆN</span>
                    </div>`;

                messages.forEach(msg => {
                    appendMessage(msg.nguoiGuiId, msg.noiDung, msg.thoiGian, msg.anhDaiDien);
                });
            }
        } catch (err) {
            console.error("Lỗi tải lịch sử: ", err);
        }
    }

    // ==============================================================
    // 4. KẾT NỐI SIGNALR 
    // ==============================================================
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chathub")
        .withAutomaticReconnect()
        .build();

    connection.on("ReceiveMessage", async (senderId, receiverId, content, time) => {
        if ((senderId === myId && receiverId === friendId) || 
            (senderId === friendId && receiverId === myId)) {
            appendMessage(senderId, content, time, null); 
            
            if (senderId === friendId) {
                await fetch(`/api/chat/mark-read/${myId}/${friendId}`, { method: 'POST' });
            }
        }
        loadRecentConversations();
    });

    connection.start()
        .then(() => console.log("Đã kết nối SignalR thành công!"))
        .catch(err => console.error("Lỗi kết nối SignalR: ", err));

    // ==============================================================
    // 5. BẮT SỰ KIỆN GỬI TIN NHẮN
    // ==============================================================
    btnSend.addEventListener('click', async () => {
        if (!friendId) return alert("Vui lòng tìm và chọn một nhân viên để chat trước!");
        if (connection.state !== signalR.HubConnectionState.Connected) return alert("Đang kết nối đến máy chủ Chat, vui lòng đợi...");

        const msg = txtMessage.value.trim();
        if (msg) {
            try {
                await connection.invoke("SendMessage", myId, friendId, msg);
                txtMessage.value = ''; 
                txtMessage.focus();
            } catch (err) { console.error("Lỗi gửi tin nhắn: ", err); }
        }
    });

    txtMessage.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            e.preventDefault(); 
            btnSend.click();    
        }
    });

    // ==============================================================
    // 6. TÌM KIẾM NGƯỜI CHAT
    // ==============================================================
    let searchTimeout = null;

    txtSearchUser.addEventListener('input', (e) => {
        const query = e.target.value.trim();
        clearTimeout(searchTimeout);

        searchTimeout = setTimeout(async () => {
            if (query.length === 0) {
                loadRecentConversations();
                return;
            }

            try {
                const response = await fetch(`/api/chat/search?q=${encodeURIComponent(query)}&currentUserId=${myId}`);
                if (response.ok) {
                    const users = await response.json();
                    const mappedUsers = users.map(u => ({
                        friendId: u.maNhanVien,
                        friendName: u.hoTen,
                        friendAvatar: u.anhDaiDien,
                        lastMessageContent: 'Nhấn để bắt đầu chat',
                        hasUnread: false 
                    }));
                    renderConversations(mappedUsers);
                }
            } catch (err) { console.error("Lỗi tìm kiếm: ", err); }
        }, 500); 
    });

    // Bắt đầu
    loadRecentConversations();
</script>
</body>
</html>