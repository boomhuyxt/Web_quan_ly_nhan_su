@model IEnumerable<Web_quan_ly_nhan_su.Models.NhanVien>
@{
    ViewData["Title"] = "Quản lý chấm công nhân viên";
    ViewData["PageHeader"] = "Quản lý chấm công";

    int? selectedNhanVien = ViewBag.SelectedNhanVien as int?;
    string tenNhanVien = ViewBag.TenNhanVien as string ?? "";
    int currentMonth = ViewBag.Thang ?? DateTime.Now.Month;
    int currentYear = ViewBag.Nam ?? DateTime.Now.Year;

    var dsChamCong = ViewBag.DsChamCong as List<Web_quan_ly_nhan_su.Models.ChamCong> ?? new List<Web_quan_ly_nhan_su.Models.ChamCong>();
}

<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
</head>
<body class="bg-surface font-body text-on-surface selection:bg-primary/10">

    <main class="pt-8 pb-32 px-6 max-w-6xl mx-auto space-y-8">
        <div class="flex items-center justify-between border-b border-gray-200 pb-4">
            <div>
                <h1 class="text-3xl font-headline font-bold text-primary">Bảng chấm công nhân viên</h1>
                <p class="text-sm text-secondary">Xem và hiệu chỉnh dữ liệu chấm công chi tiết theo từng cá nhân</p>
            </div>
         
        </div>

        <section class="bg-surface-container-lowest rounded-3xl p-6 shadow-[0_10px_30px_rgba(0,0,0,0.02)] border border-gray-100">
            <form method="get" action="@Url.Action("QuanLyChamCong", "Home")" class="grid grid-cols-1 md:grid-cols-5 gap-4 items-end">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-secondary mb-2">Tìm tên nhân viên</label>
                    <input type="text" name="tenNhanVien" value="@tenNhanVien" placeholder="Nhập từ khóa tên..."
                           class="w-full rounded-xl border-gray-200 text-sm focus:border-primary focus:ring-primary h-[42px]" />
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-secondary mb-2">Hoặc lọc theo mã</label>
                    <select name="maNhanVien" class="w-full rounded-xl border-gray-200 text-sm focus:border-primary focus:ring-primary h-[42px]">
                        <option value="">-- Tất cả nhân viên --</option>
                        @foreach (var nv in Model)
                        {
                            if (selectedNhanVien == nv.MaNhanVien)
                            {
                                <option value="@nv.MaNhanVien" selected>@nv.HoTen (@nv.MaNhanVien)</option>
                            }
                            else
                            {
                                <option value="@nv.MaNhanVien">@nv.HoTen (@nv.MaNhanVien)</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-secondary mb-2">Tháng</label>
                    <select name="thang" class="w-full rounded-xl border-gray-200 text-sm focus:border-primary focus:ring-primary h-[42px]">
                        @for (int m = 1; m <= 12; m++)
                        {
                            if (m == currentMonth)
                            {
                                <option value="@m" selected>Tháng @m</option>
                            }
                            else
                            {
                                <option value="@m">Tháng @m</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-secondary mb-2">Năm</label>
                    <select name="nam" class="w-full rounded-xl border-gray-200 text-sm focus:border-primary focus:ring-primary h-[42px]">
                        @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 1; y++)
                        {
                            if (y == currentYear)
                            {
                                <option value="@y" selected>Năm @y</option>
                            }
                            else
                            {
                                <option value="@y">Năm @y</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <button type="submit" class="w-full bg-primary hover:bg-primary-container text-white font-semibold text-sm py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 shadow-md transition-all h-[42px]">
                        <span class="material-symbols-outlined text-[20px]">search</span> Tìm & Lọc
                    </button>
                </div>
            </form>
        </section>

        <section class="bg-surface-container-lowest rounded-[32px] p-2 shadow-[0_10px_20px_rgba(0,0,0,0.02)] border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="text-secondary text-xs uppercase tracking-wider border-b border-gray-100 bg-gray-50/50">
                            <th class="p-4 font-semibold">Mã NV</th>
                            <th class="p-4 font-semibold">Nhân viên</th>
                            <th class="p-4 font-semibold">Ngày làm việc</th>
                            <th class="p-4 font-semibold text-center">Giờ vào</th>
                            <th class="p-4 font-semibold text-center">Giờ ra</th>
                            <th class="p-4 font-semibold text-center">Trạng thái</th>
                            <th class="p-4 font-semibold text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50 text-sm">
                        @if (!dsChamCong.Any())
                        {
                            <tr>
                                <td colspan="7" class="p-8 text-center text-outline">Không tìm thấy dữ liệu chấm công cho bộ lọc hiện tại.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var cc in dsChamCong)
                            {
                                <tr>
                                    <td class="p-4 font-medium text-gray-600">@cc.MaNhanVien</td>
                                    <td class="p-4 font-semibold">@(cc.NhanVien?.HoTen ?? "N/A")</td>
                                    <td class="p-4">@cc.NgayLamViec.ToString("dd/MM/yyyy")</td>
                                    <td class="p-4 text-center font-mono">@(cc.GioVao?.ToString(@"hh\:mm") ?? "--:--")</td>
                                    <td class="p-4 text-center font-mono">@(cc.GioRa?.ToString(@"hh\:mm") ?? "--:--")</td>
                                    <td class="p-4 text-center">
                                        @if (cc.GioVao.HasValue)
                                        {
                                            <span class="px-2.5 py-1 inline-flex text-xs font-semibold leading-5 rounded-full bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200/60">Đã chấm công</span>
                                        }
                                        else
                                        {
                                            <span class="px-2.5 py-1 inline-flex text-xs font-semibold leading-5 rounded-full bg-red-50 text-error ring-1 ring-red-200/60">Chưa chấm công</span>
                                        }
                                    </td>
                                    <td class="p-4 text-center">
                                        <button onclick="openEditModal(@cc.MaChamCong, @cc.MaNhanVien, '@(cc.NhanVien?.HoTen)', '@cc.NgayLamViec.ToString("yyyy-MM-dd")', '@cc.GioVao', '@cc.GioRa')"
                                                class="text-primary hover:text-primary-container p-1 rounded-lg hover:bg-blue-50 transition-colors inline-flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[18px]">edit</span> Sửa
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <div id="editModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-[32px] w-full max-w-md p-6 shadow-2xl relative space-y-6 animate-in fade-in zoom-in-95 duration-200">
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="text-xl font-headline font-bold text-gray-900">Cập nhật chấm công</h3>
                    <p class="text-xs text-secondary mt-0.5" id="modalSubTitle">Nhân viên: Nguyễn Văn A</p>
                </div>
                <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600 rounded-full p-1 hover:bg-gray-100">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form id="editChamCongForm" class="space-y-4">
                <input type="hidden" id="modalMaChamCong" name="MaChamCong" />
                <input type="hidden" id="modalMaNhanVien" name="MaNhanVien" />
                <input type="hidden" id="modalNgayLamViec" name="NgayLamViec" />

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-secondary mb-2">Trạng thái công</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="flex items-center justify-center p-3 rounded-xl border border-gray-200 cursor-pointer hover:bg-gray-50 has-[:checked]:border-primary has-[:checked]:bg-blue-50/50 group transition-all">
                            <input type="radio" name="TrangThaiCong" value="co" id="radioCo" class="sr-only" onchange="toggleTimeInputs(true)" />
                            <span class="text-sm font-semibold text-gray-700 group-has-[:checked]:text-primary">Đã chấm công</span>
                        </label>
                        <label class="flex items-center justify-center p-3 rounded-xl border border-gray-200 cursor-pointer hover:bg-gray-50 has-[:checked]:border-error has-[:checked]:bg-red-50 group transition-all">
                            <input type="radio" name="TrangThaiCong" value="khong" id="radioKhong" class="sr-only" onchange="toggleTimeInputs(false)" />
                            <span class="text-sm font-semibold text-gray-700 group-has-[:checked]:text-error">Chưa chấm công</span>
                        </label>
                    </div>
                </div>

                <div id="timeInputsGroup" class="grid grid-cols-2 gap-4 transition-all">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-secondary mb-2">Giờ Vào</label>
                        <input type="time" id="modalGioVao" name="GioVao" class="w-full rounded-xl border-gray-200 text-sm focus:border-primary focus:ring-primary" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-secondary mb-2">Giờ Ra</label>
                        <input type="time" id="modalGioRa" name="GioRa" class="w-full rounded-xl border-gray-200 text-sm focus:border-primary focus:ring-primary" />
                    </div>
                </div>

                <div class="flex gap-3 pt-2">
                    <button type="button" onclick="closeModal()" class="w-1/2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-sm py-3 rounded-xl transition-colors">Hủy bỏ</button>
                    <button type="button" onclick="saveChamCong()" class="w-1/2 bg-primary hover:bg-primary-container text-white font-bold text-sm py-3 rounded-xl shadow-md transition-all">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openEditModal(maChamCong, maNhanVien, hoTen, ngayLamViec, gioVao, gioRa) {
        document.getElementById('modalMaChamCong').value = maChamCong;
        document.getElementById('modalMaNhanVien').value = maNhanVien;
        document.getElementById('modalNgayLamViec').value = ngayLamViec;
        document.getElementById('modalSubTitle').innerText = `Nhân viên: ${hoTen} - Ngày: ${ngayLamViec}`;

        if (gioVao && gioVao !== 'null' && gioVao !== '') {
        document.getElementById('radioCo').checked = true;
        document.getElementById('modalGioVao').value = gioVao.substring(0, 5);
        document.getElementById('modalGioRa').value = (gioRa && gioRa !== 'null') ? gioRa.substring(0, 5) : '';
        toggleTimeInputs(true);
        } else {
        document.getElementById('radioKhong').checked = true;
        document.getElementById('modalGioVao').value = '08:00';
        document.getElementById('modalGioRa').value = '17:00';
        toggleTimeInputs(false);
        }
        document.getElementById('editModal').classList.remove('hidden');
        }

        function closeModal() {
        document.getElementById('editModal').classList.add('hidden');
        }

        function toggleTimeInputs(show) {
        const group = document.getElementById('timeInputsGroup');
        if (show) {
        group.xl = group.classList.remove('opacity-40', 'pointer-events-none');
        } else {
        group.classList.add('opacity-40', 'pointer-events-none');
        }
        }

        async function saveChamCong() {
        const isCheckedCo = document.getElementById('radioCo').checked;
        const data = {
        MaChamCong: parseInt(document.getElementById('modalMaChamCong').value) || 0,
        MaNhanVien: parseInt(document.getElementById('modalMaNhanVien').value),
        NgayLamViec: document.getElementById('modalNgayLamViec').value,
        GioVao: isCheckedCo ? document.getElementById('modalGioVao').value : null,
        GioRa: isCheckedCo ? document.getElementById('modalGioRa').value : null,
        IsChamCong: isCheckedCo
        };

        try {
        const response = await fetch('@Url.Action("CapNhatChamCongAdmin", "Home")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
        });

        const result = await response.json();
        if (result.success) {
        alert(result.message);
        location.reload();
        } else {
        alert('Lỗi: ' + result.message);
        }
        } catch (error) {
        alert('Có lỗi kết nối xảy ra!');
        console.error(error);
        }
        }
    </script>
</body>
</html>